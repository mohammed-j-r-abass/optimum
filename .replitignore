# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Private development context and generated release output
.agents
.config
.env
.env.*
generated-artifacts
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
.netrc
.pypirc
id_rsa
id_ed25519
credentials*.json
*service-account*.json
attached_assets
